@model ArtContest.Controllers.AdminEditContestViewModel
@using System.Text.Json
@{
    var adminLogin = ViewBag.AdminLogin ?? "—";
    var ctJson = JsonSerializer.Serialize(Model.Contest.Title);
    var cid = Model.Contest.Id;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtContest - Редактирование конкурса</title>
    <link rel="stylesheet" href="~/css/AdminEditContest.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <header class="top-bar">
        <a href="/Admin/Contests" class="back-link">
            <span class="back-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </span>
            Редактирование
        </a>
    </header>

    <main class="create-contest-content">
        <div class="form-wrapper-card">
            <form class="create-contest-form" method="post" action="/Admin/EditContest/@Model.Contest.Id" enctype="multipart/form-data" onsubmit="return validateForm()">

                @if (ViewBag.Error != null)
                {
                    <div class="form-error-message">@ViewBag.Error</div>
                }

                <div class="form-grid-layout">

                    <div class="form-fields-column">
                        <div class="input-field-group">
                            <label class="input-label">Название конкурса</label>
                            <input type="text" name="title" class="text-input" value="@Model.Contest.Title" required minlength="3" maxlength="200">
                        </div>

                        <div class="input-field-group">
                            <label class="input-label">Категория</label>
                            <div class="select-wrapper">
                                <select name="category" class="custom-select" required>
                                    @foreach (var cat in Model.Categories)
                                    {
                                        var sel = Model.Contest.IdCategory == cat.Id ? "selected" : null;
                                        <option value="@cat.Id" selected="@sel">@cat.CategoryName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="input-field-group">
                            <label class="input-label">Критерий оценки 1</label>
                            <div class="select-wrapper">
                                <select name="criteria1" class="custom-select" required>
                                    @foreach (var c in Model.Criteria1List)
                                    {
                                        var sel1 = Model.Contest.IdCriteria1 == c.Id ? "selected" : null;
                                        <option value="@c.Id" selected="@sel1">@c.Criteria1Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="input-field-group">
                            <label class="input-label">Критерий оценки 2</label>
                            <div class="select-wrapper">
                                <select name="criteria2" class="custom-select" required>
                                    @foreach (var c in Model.Criteria2List)
                                    {
                                        var sel2 = Model.Contest.IdCriteria2 == c.Id ? "selected" : null;
                                        <option value="@c.Id" selected="@sel2">@c.Criteria2Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-image-column">
                        <label class="input-label">Изображение конкурса</label>
                        <div class="upload-container">
                            <input type="file" id="contest-image-upload" name="contestImage" accept="image/png, image/jpeg" class="file-input-hidden">
                            <label for="contest-image-upload" class="upload-dropzone @(string.IsNullOrEmpty(Model.Contest.ContestImage) ? "" : "has-image")" id="dropzone-label">
                                <div class="upload-prompt" id="uploadPrompt" @(string.IsNullOrEmpty(Model.Contest.ContestImage) ? "" : "style=display:none;")>
                                    <p class="main-prompt">Нажмите для выбора нового файла</p>
                                    <p class="sub-prompt">JPG, PNG до 10MB</p>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Contest.ContestImage))
                                {
                                    <img src="@Url.Content("~/images/" + Model.Contest.ContestImage)" alt="" />
                                }
                            </label>
                        </div>
                    </div>

                </div>

                <div class="input-field-group full-width-group">
                    <label class="input-label">Правила и описание</label>
                    <textarea name="rules" class="text-area-input" rows="3" required minlength="10" maxlength="5000">@Model.Contest.Rules</textarea>
                </div>

                <div class="date-ranges-row">
                    <div class="date-range-item">
                        <label class="input-label">Прием заявок (С - По)</label>
                        <div class="date-inputs-wrapper">
                            <input type="date" name="appStartDate" id="appStartDate" class="date-input-field @(Model.AppStartPassed ? "disabled-date" : "")" value="@(Model.Contest.ApplicationPeriod?.AppStartDate)" @(Model.AppStartPassed ? "disabled" : "")>
                            <span class="date-separator">—</span>
                            <input type="date" name="appEndDate" id="appEndDate" class="date-input-field @(Model.AppEndPassed ? "disabled-date" : "")" value="@(Model.Contest.ApplicationPeriod?.AppEndDate)" @(Model.AppEndPassed ? "disabled" : "")>
                        </div>
                    </div>

                    <div class="date-range-item">
                        <label class="input-label">Этап судейства (С - По)</label>
                        <div class="date-inputs-wrapper">
                            <input type="date" name="judStartDate" id="judStartDate" class="date-input-field @(Model.JudStartPassed ? "disabled-date" : "")" value="@(Model.Contest.JudgingPeriod?.JudStartDate)" @(Model.JudStartPassed ? "disabled" : "")>
                            <span class="date-separator">—</span>
                            <input type="date" name="judEndDate" id="judEndDate" class="date-input-field" value="@(Model.Contest.JudgingPeriod?.JudEndDate)">
                        </div>
                    </div>
                </div>

                <div class="edit-actions-row">
                    <button type="submit" class="btn-save-changes">Сохранить изменения</button>
                    <button type="button" class="btn-delete-contest" id="btnDeleteContest">Удалить конкурс</button>
                </div>

            </form>
        </div>
    </main>

    <div id="modalOverlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background-color:rgba(0,0,0,0.4);align-items:center;justify-content:center;z-index:1000;">
        <div style="background:#fff;border-radius:20px;padding:40px;max-width:420px;width:90%;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,0.15);">
            <h3 style="font-size:20px;font-weight:700;color:#11142d;margin-bottom:15px;">Удаление конкурса</h3>
            <p style="font-size:15px;color:#555e75;margin-bottom:30px;" id="modalText">Вы уверены?</p>
            <div style="display:flex;gap:15px;justify-content:center;">
                <button style="padding:14px 30px;border-radius:12px;font-size:15px;font-weight:600;cursor:pointer;border:none;background-color:#f6f7fb;color:#555e75;" id="btnModalCancel">Отмена</button>
                <button style="padding:14px 30px;border-radius:12px;font-size:15px;font-weight:600;cursor:pointer;border:none;background-color:#e84a4a;color:#ffffff;" id="btnModalConfirm">Удалить</button>
            </div>
        </div>
    </div>

    <script src="~/js/admin-contest-form.js"></script>
    <script>
        var _cid = @cid;
        var _ct = @Html.Raw(ctJson);

        document.getElementById('btnDeleteContest').onclick = function () {
            document.getElementById('modalText').textContent = 'Вы уверены, что хотите удалить конкурс "' + _ct + '"? Это действие нельзя отменить.';
            var overlay = document.getElementById('modalOverlay');
            overlay.style.display = 'flex';
        };
        document.getElementById('btnModalCancel').onclick = function () {
            document.getElementById('modalOverlay').style.display = 'none';
        };
        document.getElementById('btnModalConfirm').onclick = function () {
            var f = document.createElement('form');
            f.method = 'POST';
            f.action = '/Admin/DeleteContest';
            var i = document.createElement('input');
            i.type = 'hidden'; i.name = 'id'; i.value = _cid;
            f.appendChild(i);
            document.body.appendChild(f);
            f.submit();
        };
    </script>

</body>
</html>
