<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtContest - История оценок</title>
    <link rel="stylesheet" href="~/css/JuryHistory.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <aside class="sidebar">
        <div class="logo">ArtContest</div>
        <nav class="menu">
            <a href="/Jury/Home" class="menu-item">Главная</a>
            <a href="/Jury/History" class="menu-item active">История</a>
        </nav>
    </aside>

    <main class="main-content">
        <header class="content-header">
            <h1 class="page-title">История оценок</h1>
            <a href="/Auth/Login" class="logout-trigger">
                <span class="logout-text">Выйти</span>
                <span class="logout-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                </span>
            </a>
        </header>

        <section class="filters-container">
            <div class="search-wrapper">
                <input type="text" class="search-input" placeholder="Поиск работ">
                <span class="search-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </span>
            </div>

            <div class="select-wrapper">
                <select class="filter-select">
                    <option value="" disabled selected hidden>Конкурс</option>
                    <option value="autumn">Осенняя палитра</option>
                    <option value="digital">Цифровой портрет</option>
                </select>
            </div>

            <div class="select-wrapper">
                <select class="filter-select">
                    <option value="" disabled selected hidden>Категория</option>
                    <option value="photo">Фотография</option>
                    <option value="digital">Digital Art</option>
                </select>
            </div>
        </section>

        <section class="table-container">
            <table class="log-table">
                <thead>
                    <tr>
                        <th>Название работы</th>
                        <th>Автор</th>
                        <th>Конкурс</th>
                        <th>Оценка 1</th>
                        <th>Оценка 2</th>
                        <th>Комментарий</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="work-name-td">Лесной ручей</span></td>
                        <td>Сергей С.</td>
                        <td>Осенняя палитра</td>
                        <td><span class="score-cell">42 / 50</span></td>
                        <td><span class="score-cell">45 / 50</span></td>
                        <td class="comment-td">Прекрасная работа со светотенью и композицией.</td>
                    </tr>
                    <tr>
                        <td><span class="work-name-td">Абстрактный разум</span></td>
                        <td>Дмитрий К.</td>
                        <td>Цифровой портрет</td>
                        <td><span class="score-cell">28 / 50</span></td>
                        <td><span class="score-cell">31 / 50</span></td>
                        <td class="comment-td">Интересная задумка, но анатомия лица требует детальной проработки.</td>
                    </tr>
                    <tr>
                        <td><span class="work-name-td">Закат в горах</span></td>
                        <td>Елена М.</td>
                        <td>Осенняя палитра</td>
                        <td><span class="score-cell">50 / 50</span></td>
                        <td><span class="score-cell">48 / 50</span></td>
                        <td class="comment-td">Потрясающая детализация и глубина пространства.</td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>

</body>
</html>
