<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtContest - Победители</title>
    <link rel="stylesheet" href="~/css/UserWinners.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <header class="top-bar">
        <a href="/User/Gallery" class="back-link">
            <span class="back-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </span>
            Победители: Весенний вернисаж 2025
        </a>
    </header>

    <main class="winners-page-content">
        <div class="podium-grid">

            <article class="podium-card place-gold">
                <div class="podium-image-bg bg-gold"></div>
                <div class="rank-circle rank-1">1</div>
                <div class="podium-details">
                    <h2 class="work-name">Пробуждение</h2>
                    <p class="author-name">Автор: Алексей С.</p>
                    <p class="score-label">95 баллов</p>
                </div>
            </article>

            <article class="podium-card place-silver">
                <div class="podium-image-bg bg-silver"></div>
                <div class="rank-circle rank-2">2</div>
                <div class="podium-details">
                    <h2 class="work-name">Тихая заводь</h2>
                    <p class="author-name">Автор: Мария В.</p>
                    <p class="score-label">88 баллов</p>
                </div>
            </article>

            <article class="podium-card place-bronze">
                <div class="podium-image-bg bg-bronze"></div>
                <div class="rank-circle rank-3">3</div>
                <div class="podium-details">
                    <h2 class="work-name">Городские огни</h2>
                    <p class="author-name">Автор: Дмитрий П.</p>
                    <p class="score-label">82 баллов</p>
                </div>
            </article>

        </div>
    </main>

</body>
</html>
