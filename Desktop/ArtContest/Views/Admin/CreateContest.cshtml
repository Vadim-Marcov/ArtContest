@model ArtContest.Controllers.AdminCreateContestViewModel
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtContest - Создание нового конкурса</title>
    <link rel="stylesheet" href="~/css/AdminCreateContest.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <header class="top-bar">
        <a href="/Admin/Contests" class="back-link">
            <span class="back-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </span>
            Создание нового конкурса
        </a>
    </header>

    <main class="create-contest-content">
        <div class="form-wrapper-card">
            <form class="create-contest-form" method="post" action="/Admin/CreateContest" enctype="multipart/form-data" onsubmit="return validateForm()">

                @if (ViewBag.Error != null)
                {
                    <div class="form-error-message">@ViewBag.Error</div>
                }

                <div class="form-grid-layout">

                    <div class="form-fields-column">
                        <div class="input-field-group">
                            <label class="input-label">Название конкурса</label>
                            <input type="text" name="title" class="text-input" placeholder="Введите название" required minlength="3" maxlength="200">
                        </div>

                        <div class="input-field-group">
                            <label class="input-label">Категория</label>
                            <div class="select-wrapper">
                                <select name="category" class="custom-select" required>
                                    <option value="" disabled selected hidden>Выберите категорию</option>
                                    @foreach (var cat in Model.Categories)
                                    {
                                        <option value="@cat.Id">@cat.CategoryName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="input-field-group">
                            <label class="input-label">Критерий оценки 1</label>
                            <div class="select-wrapper">
                                <select name="criteria1" class="custom-select" required>
                                    <option value="" disabled selected hidden>Выберите критерий</option>
                                    @foreach (var c in Model.Criteria1List)
                                    {
                                        <option value="@c.Id">@c.Criteria1Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="input-field-group">
                            <label class="input-label">Критерий оценки 2</label>
                            <div class="select-wrapper">
                                <select name="criteria2" class="custom-select" required>
                                    <option value="" disabled selected hidden>Выберите критерий</option>
                                    @foreach (var c in Model.Criteria2List)
                                    {
                                        <option value="@c.Id">@c.Criteria2Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-image-column">
                        <label class="input-label">Изображение конкурса *</label>
                        <div class="upload-container">
                            <input type="file" id="contest-image-upload" name="contestImage" accept="image/png, image/jpeg" class="file-input-hidden">
                            <label for="contest-image-upload" class="upload-dropzone" id="dropzone-label">
                                <div class="upload-prompt" id="uploadPrompt">
                                    <p class="main-prompt">Перетащите файл сюда</p>
                                    <p class="sub-prompt">JPG, PNG до 10MB</p>
                                </div>
                            </label>
                        </div>
                    </div>

                </div>

                <div class="input-field-group full-width-group">
                    <label class="input-label">Правила и описание</label>
                    <textarea name="rules" class="text-area-input" placeholder="Добавьте требования" rows="3" required minlength="10" maxlength="5000"></textarea>
                </div>

                <div class="date-ranges-row">
                    <div class="date-range-item">
                        <label class="input-label">Прием заявок (С - По)</label>
                        <div class="date-inputs-wrapper">
                            <input type="date" name="appStartDate" id="appStartDate" class="date-input-field" required>
                            <span class="date-separator">—</span>
                            <input type="date" name="appEndDate" id="appEndDate" class="date-input-field" required>
                        </div>
                    </div>

                    <div class="date-range-item">
                        <label class="input-label">Этап судейства (С - По)</label>
                        <div class="date-inputs-wrapper">
                            <input type="date" name="judStartDate" id="judStartDate" class="date-input-field" required>
                            <span class="date-separator">—</span>
                            <input type="date" name="judEndDate" id="judEndDate" class="date-input-field" required>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-submit-contest">Запустить конкурс</button>

            </form>
        </div>
    </main>

    <script src="~/js/admin-contest-form.js"></script>

</body>
</html>
