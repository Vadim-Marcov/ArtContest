@model List<ArtContest.Models.Region>
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtContest - Регистрация</title>
    <link rel="stylesheet" href="~/css/Register.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <div class="auth-card">
        <h1 class="auth-title">Регистрация в ArtContest</h1>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">@ViewBag.Error</div>
        }

        <form class="auth-form" method="post" action="/Auth/Register" onsubmit="return validateRegisterForm()">
            <div class="input-group">
                <input type="text" id="regLogin" name="login" placeholder="Логин" required minlength="3" maxlength="50">
            </div>

            <div class="input-group">
                <input type="email" id="regEmail" name="email" placeholder="E-mail" required maxlength="100">
            </div>

            <div class="input-group">
                <input type="text" id="regBirthDate" name="birthDate" placeholder="Дата рождения" onfocus="(this.type='date')" onblur="if(!this.value)this.type='text'" required>
            </div>

            <div class="input-group select-wrapper">
                <select id="regRegion" name="region" required>
                    <option value="" disabled selected hidden>Регион</option>
                    @foreach (var region in Model)
                    {
                        <option value="@region.Id">@region.RegionName</option>
                    }
                </select>
            </div>

            <div class="input-group password-group">
                <input type="password" id="regPassword" name="password" placeholder="Пароль" required minlength="6" maxlength="100">
            </div>

            <div class="input-group password-group">
                <input type="password" id="regConfirmPassword" name="confirmPassword" placeholder="Повторите пароль" required minlength="6" maxlength="100">
            </div>

            <button type="submit" class="btn-submit">Зарегистрироваться</button>
        </form>

        <div class="auth-footer">
            <a href="/Auth/Login" class="auth-link">Есть аккаунт? Авторизация</a>
        </div>
    </div>

    <script src="~/js/auth-validation.js"></script>

</body>
</html>
