@{
    var submission = ViewBag.Submission as ArtContest.Models.Submission;
    var existingAssessment = ViewBag.ExistingAssessment as ArtContest.Models.JuryAssessment;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtContest - Оценка работы</title>
    <link rel="stylesheet" href="~/css/JuryReview.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <header class="top-bar">
        <a href="/Jury/ContestItems/@submission?.Contest?.Id" class="back-link">
            <span class="back-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </span>
            Работа: «@submission?.Title» (Автор: @submission?.User?.Login)
        </a>
    </header>

    <main class="submit-page-content">
        @if (ViewBag.Success != null)
        {
            <div class="success-message">@ViewBag.Success</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="form-error-message">@ViewBag.Error</div>
        }

        @if (submission != null)
        {
            <section class="info-section">
                <h2 class="info-section-title">Описание работы</h2>
                <div class="info-text-block">
                    <p>@(submission.AuthorDescription ?? "Описание отсутствует")</p>
                </div>
            </section>

            <div class="submission-grid">
                <div class="upload-container">
                    @if (!string.IsNullOrEmpty(submission.SubmissionImage))
                    {
                        <div class="upload-dropzone" style="border-style:solid;">
                            <div class="upload-prompt">
                                <img src="@Url.Content("~/images/" + submission.SubmissionImage)" alt="@submission.Title" style="max-width:100%;max-height:100%;object-fit:contain;border-radius:10px;" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="upload-dropzone">
                            <div class="upload-prompt">
                                <p class="main-prompt">[Изображение работы]</p>
                            </div>
                        </div>
                    }
                </div>

                <form class="submission-form" method="post" action="/Jury/Review">
                    <input type="hidden" name="submissionId" value="@submission.Id" />
                    <div class="form-card">
                        <h2 class="form-card-title">Выставление оценки</h2>

                        <div class="input-field-group">
                            <label class="input-label">@(submission.Contest?.Criteria1?.Criteria1Name ?? "Критерий 1") (0-50)</label>
                            <input type="number" name="score1" class="text-input" placeholder="Введите балл" min="0" max="50" required value="@(existingAssessment?.Score1.ToString() ?? "")">
                        </div>

                        <div class="input-field-group">
                            <label class="input-label">@(submission.Contest?.Criteria2?.Criteria2Name ?? "Критерий 2") (0-50)</label>
                            <input type="number" name="score2" class="text-input" placeholder="Введите балл" min="0" max="50" required value="@(existingAssessment?.Score2.ToString() ?? "")">
                        </div>

                        <div class="input-field-group">
                            <label class="input-label">Комментарий (Отзыв)</label>
                            <textarea name="juryComment" class="text-area-input" placeholder="Напишите ваш отзыв участнику" rows="5" required>@(existingAssessment?.JuryComment ?? "")</textarea>
                        </div>

                        <button type="submit" class="btn-submit-work">@(existingAssessment != null ? "Обновить оценку" : "Сохранить оценку")</button>
                    </div>
                </form>
            </div>
        }
        else
        {
            <div style="text-align:center;padding:80px 20px;color:#7c8295;">
                Работа не найдена
            </div>
        }
    </main>

    <style>
        .form-error-message {
            background-color: #ffe5e5;
            color: #ff4d4d;
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 20px;
            text-align: center;
        }
        .success-message {
            background-color: #e1fcef;
            color: #00ca72;
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 20px;
            text-align: center;
        }
    </style>

</body>
</html>
