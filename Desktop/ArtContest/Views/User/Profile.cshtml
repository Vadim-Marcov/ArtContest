@model ArtContest.Controllers.UserProfileViewModel
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtContest - Профиль</title>
    <link rel="stylesheet" href="~/css/UserProfile.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <aside class="sidebar">
        <div class="logo">ArtContest</div>
        <nav class="menu">
            <a href="/User/Home" class="menu-item">Главная</a>
            <a href="/User/Profile" class="menu-item active">Профиль</a>
            <a href="/User/Gallery" class="menu-item">Галерея</a>
        </nav>
    </aside>

    <main class="main-content">
        <header class="content-header">
            <h1 class="page-title">Личный кабинет</h1>
            <a href="#" class="logout-trigger" id="logoutBtn">
                <span class="logout-text">Выйти</span>
                <span class="logout-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                </span>
            </a>
        </header>

        @if (ViewBag.Success != null)
        {
            <div class="success-message">@ViewBag.Success</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="error-message">@ViewBag.Error</div>
        }

        <form class="profile-card-form" method="post" action="/User/Profile" enctype="multipart/form-data">
            <div class="profile-meta-container">
                <div class="avatar-container">
                    <div class="profile-avatar-big" id="avatarPreview">
                        @if (!string.IsNullOrEmpty(Model.User.ProfilePhoto))
                        {
                            <img src="@Url.Content("~/images/" + Model.User.ProfilePhoto)" alt="Аватар" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
                        }
                    </div>
                    <input type="file" id="profile-photo-input" name="profilePhoto" accept="image/png, image/jpeg" class="file-input-hidden">
                    <button type="button" class="btn-change-photo" onclick="document.getElementById('profile-photo-input').click()">Изменить фото</button>
                </div>

                <div class="profile-form-grid">
                    <div class="form-field">
                        <label class="field-label">Логин</label>
                        <input type="text" name="login" class="field-input" value="@Model.User.Login" required minlength="3" maxlength="50">
                    </div>

                    <div class="form-field">
                        <label class="field-label">E-mail</label>
                        <input type="email" name="email" class="field-input" value="@Model.User.Email" required maxlength="100">
                    </div>

                    <div class="form-field">
                        <label class="field-label">Дата рождения</label>
                        <input type="date" name="birthDate" class="field-input" value="@Model.User.BirthDate" required>
                    </div>

                    <div class="form-field">
                        <label class="field-label">Регион</label>
                        <div class="select-field-wrapper">
                            <select name="region" class="field-select" required>
                                @foreach (var reg in Model.Regions)
                                {
                                    var regSel = Model.User.IdRegion == reg.Id ? "selected" : null;
                                    <option value="@reg.Id" selected="@regSel">@reg.RegionName</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-save-full-width">Сохранить изменения</button>
        </form>

        <section class="history-container">
            <h2 class="section-title">История заявок</h2>

            <div class="table-container">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Название работы</th>
                            <th>Дата подачи</th>
                            <th>Конкурс</th>
                            <th>Статус</th>
                            <th>Комментарий модератора</th>
                            <th>Комментарии жюри</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Submissions.Any())
                        {
                            @foreach (var submission in Model.Submissions)
                            {
                                <tr>
                                    <td><span class="work-name-td">@submission.Title</span></td>
                                    <td class="date-td">@submission.SubmissionDate</td>
                                    <td>@submission.Contest?.Title</td>
                                    <td>
                                        @if (submission.ModeratorLog != null)
                                        {
                                            var statusClass = submission.ModeratorLog.Status switch
                                            {
                                                "Одобрено" => "status-approved",
                                                "Отклонено" => "status-rejected",
                                                "На доработку" => "status-fix",
                                                _ => "status-pending"
                                            };
                                            <span class="status-badge @statusClass">@submission.ModeratorLog.Status</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-pending">Модерация</span>
                                        }
                                    </td>
                                    <td class="comment-td">@(string.IsNullOrEmpty(submission.ModeratorLog?.ModComment) ? "—" : submission.ModeratorLog.ModComment)</td>
                                    <td class="comment-td">
                                        @if (!string.IsNullOrEmpty(submission.AuthorDescription))
                                        {
                                            @submission.AuthorDescription
                                        }
                                        else
                                        {
                                            <text>—</text>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="text-align:center;padding:40px;color:#7c8295;">У вас пока нет заявок</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <div id="logoutModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background-color:rgba(0,0,0,0.4);align-items:center;justify-content:center;z-index:1000;">
        <div style="background:#fff;border-radius:20px;padding:40px;max-width:420px;width:90%;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,0.15);">
            <h3 style="font-size:20px;font-weight:700;color:#11142d;margin-bottom:15px;">Выход</h3>
            <p style="font-size:15px;color:#555e75;margin-bottom:30px;">Вы уверены, что хотите выйти из аккаунта?</p>
            <div style="display:flex;gap:15px;justify-content:center;">
                <button style="padding:14px 30px;border-radius:12px;font-size:15px;font-weight:600;cursor:pointer;border:none;background-color:#f6f7fb;color:#555e75;" id="logoutCancelBtn">Отмена</button>
                <button style="padding:14px 30px;border-radius:12px;font-size:15px;font-weight:600;cursor:pointer;border:none;background-color:#e84a4a;color:#ffffff;" id="logoutConfirmBtn">Выйти</button>
            </div>
        </div>
    </div>

    <style>
        .file-input-hidden {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            padding: 0 !important;
            margin: -1px !important;
            overflow: hidden !important;
            clip: rect(0, 0, 0, 0) !important;
            white-space: nowrap !important;
            border: 0 !important;
            opacity: 0 !important;
        }
        .profile-avatar-big {
            width: 160px;
            height: 160px;
            background-color: #e2e5ed;
            border-radius: 50%;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .success-message {
            background-color: #e1fcef;
            color: #00ca72;
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 20px;
            text-align: center;
        }
    </style>

    <script>
        document.getElementById('logoutBtn').onclick = function(e) {
            e.preventDefault();
            document.getElementById('logoutModal').style.display = 'flex';
        };
        document.getElementById('logoutCancelBtn').onclick = function() {
            document.getElementById('logoutModal').style.display = 'none';
        };
        document.getElementById('logoutConfirmBtn').onclick = function() {
            window.location.href = '/Auth/Login';
        };
        document.getElementById('logoutModal').onclick = function(e) {
            if (e.target === this) this.style.display = 'none';
        };

        var photoInput = document.getElementById('profile-photo-input');
        var avatarPreview = document.getElementById('avatarPreview');
        if (photoInput && avatarPreview) {
            photoInput.addEventListener('change', function() {
                if (this.files && this.files.length > 0) {
                    var file = this.files[0];
                    var allowed = ['.jpg', '.jpeg', '.png'];
                    var ext = file.name.toLowerCase().substring(file.name.lastIndexOf('.'));
                    if (allowed.indexOf(ext) === -1) { alert('Допустимые форматы: JPG, JPEG, PNG'); this.value = ''; return; }
                    if (file.size > 5 * 1024 * 1024) { alert('Размер фото не может превышать 5 МБ'); this.value = ''; return; }
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        avatarPreview.innerHTML = '<img src="' + e.target.result + '" alt="Аватар" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />';
                    };
                    reader.readAsDataURL(file);
                }
            });
        }
    </script>

</body>
</html>
