@model ArtContest.Controllers.AdminContestsViewModel
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtContest - Управление конкурсами</title>
    <link rel="stylesheet" href="~/css/AdminContests.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <aside class="sidebar">
        <div class="logo">ArtContest</div>
        <nav class="menu">
            <a href="/Admin/Analytics" class="menu-item">Аналитика</a>
            <a href="/Admin/Users" class="menu-item">Пользователи</a>
            <a href="/Admin/Contests" class="menu-item active">Конкурсы</a>
        </nav>
    </aside>

    <main class="main-content">

        <header class="content-header">
            <h1 class="page-title">Управление конкурсами</h1>
            <a href="/Admin/CreateContest" class="btn-create-contest">+ Создать конкурс</a>
        </header>

        <section class="contests-list-container">
            @foreach (var contest in Model.Contests)
            {
                var appPeriod = contest.ApplicationPeriod;
                var judPeriod = contest.JudgingPeriod;
                var currentStage = contest.IdStage;

                var appStart = appPeriod != null ? DateTime.Parse(appPeriod.AppStartDate) : DateTime.MinValue;
                var appEnd = appPeriod != null ? DateTime.Parse(appPeriod.AppEndDate) : DateTime.MinValue;
                var judStart = judPeriod != null ? DateTime.Parse(judPeriod.JudStartDate) : DateTime.MinValue;
                var judEnd = judPeriod != null ? DateTime.Parse(judPeriod.JudEndDate) : DateTime.MinValue;
                var now = DateTime.Now;

                double progressPercent = 0;
                if (currentStage == 4)
                {
                    progressPercent = 100;
                }
                else if (appPeriod != null && judPeriod != null)
                {
                    var totalDays = (judEnd - appStart).TotalDays;
                    var elapsed = (now - appStart).TotalDays;
                    if (totalDays > 0)
                    {
                        progressPercent = Math.Min(95, Math.Max(5, Math.Round((elapsed / totalDays) * 100) / 10 * 10));
                    }
                }
                else if (currentStage == 2)
                {
                    progressPercent = 35;
                }
                else if (currentStage == 3)
                {
                    progressPercent = 70;
                }

                var stage1Done = currentStage >= 2 || (appPeriod != null && now > appEnd);
                var stage2Done = currentStage >= 3 || (judPeriod != null && now > judStart);
                var stage3Done = currentStage >= 4 || (judPeriod != null && now > judEnd);

                <article class="contest-management-card">
                    <div class="card-body-layout">

                        <div class="contest-timeline-block">
                            <h2 class="contest-card-title">@contest.Title</h2>

                            <div class="timeline-wrapper">
                                <p class="timeline-header-label">ВРЕМЕННЫЕ ЭТАПЫ:</p>

                                <div class="timeline-track-container">
                                    <div class="timeline-line-progress" style="width: @progressPercent%;"></div>

                                    <div class="timeline-nodes">
                                        <div class="timeline-node @(stage1Done ? "done" : "")">
                                            <div class="node-dot"></div>
                                            <span class="node-title">Прием заявок</span>
                                            <span class="node-date">@(appPeriod != null ? appStart.ToString("dd.MM") + " - " + appEnd.ToString("dd.MM") : "—")</span>
                                        </div>

                                        <div class="timeline-node @(stage2Done ? "done" : "")">
                                            <div class="node-dot"></div>
                                            <span class="node-title">Этап судейства</span>
                                            <span class="node-date">@(judPeriod != null ? judStart.ToString("dd.MM") + " - " + judEnd.ToString("dd.MM") : "—")</span>
                                        </div>

                                        <div class="timeline-node @(stage3Done ? "done" : "")">
                                            <div class="node-dot"></div>
                                            <span class="node-title">Итоги</span>
                                            <span class="node-date">@(judPeriod != null ? judEnd.ToString("dd.MM.yyyy") : "—")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="card-action-block">
                            <a href="/Admin/EditContest/@contest.Id" class="btn-card-edit">Редактировать</a>
                        </div>

                    </div>
                </article>
            }

            @if (!Model.Contests.Any())
            {
                <div class="empty-state">
                    <p>Конкурсов пока нет. Создайте первый!</p>
                </div>
            }
        </section>
    </main>

</body>
</html>
