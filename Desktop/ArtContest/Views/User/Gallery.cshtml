<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtContest - Галерея</title>
    <link rel="stylesheet" href="~/css/UserGallery.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <aside class="sidebar">
        <div class="logo">ArtContest</div>
        <nav class="menu">
            <a href="/User/Home" class="menu-item">Главная</a>
            <a href="/User/Profile" class="menu-item">Профиль</a>
            <a href="/User/Gallery" class="menu-item active">Галерея</a>
        </nav>
    </aside>

    <main class="main-content">
        <header class="content-header">
            <h1 class="page-title">Архив конкурсов</h1>
            <div class="user-profile-trigger">
                <div class="user-avatar-mini"></div>
            </div>
        </header>

        <section class="filters-container">
            <div class="search-wrapper">
                <input type="text" class="search-input" placeholder="Поиск конкурсов">
                <span class="search-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </span>
            </div>

            <div class="select-wrapper">
                <select class="filter-select">
                    <option value="" disabled selected hidden>Все категории</option>
                    <option value="photo">Фотография</option>
                    <option value="drawing">Рисунок</option>
                </select>
            </div>

            <div class="select-wrapper">
                <select class="filter-select">
                    <option value="" disabled selected hidden>По дате завершения</option>
                    <option value="new">Сначала новые</option>
                    <option value="old">Сначала старые</option>
                </select>
            </div>
        </section>

        <section class="contests-grid">
            <article class="contest-card archive-card">
                <div class="contest-image-holder image-bg-green"></div>
                <div class="contest-card-content">
                    <h2 class="contest-title">Зимняя сказка 2025</h2>
                    <p class="contest-info">Категория: Рисунок</p>
                    <p class="contest-deadline status-finished">Завершен: 20 января 2026</p>
                    <a href="/User/Winners" class="btn-action visual-archive-btn">Посмотреть победителей</a>
                </div>
            </article>

            <article class="contest-card archive-card">
                <div class="contest-image-holder image-bg-purple"></div>
                <div class="contest-card-content">
                    <h2 class="contest-title">Взгляд сквозь время</h2>
                    <p class="contest-info">Категория: Фотография</p>
                    <p class="contest-deadline status-finished">Завершен: 14 февраля 2026</p>
                    <a href="/User/Winners" class="btn-action visual-archive-btn">Посмотреть победителей</a>
                </div>
            </article>
        </section>
    </main>

</body>
</html>
