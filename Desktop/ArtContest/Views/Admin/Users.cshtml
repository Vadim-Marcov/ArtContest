@model ArtContest.Controllers.AdminUsersViewModel
@{
    var adminLogin = ViewBag.AdminLogin ?? "—";
    var selectedRole = Model.SelectedRole;
    var sort = Model.Sort;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtContest - База пользователей</title>
    <link rel="stylesheet" href="~/css/AdminUsers.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <aside class="sidebar">
        <div class="logo">ArtContest</div>
        <nav class="menu">
            <a href="/Admin/Analytics" class="menu-item">Аналитика</a>
            <a href="/Admin/Users" class="menu-item active">Пользователи</a>
            <a href="/Admin/Contests" class="menu-item">Конкурсы</a>
        </nav>
    </aside>

    <main class="main-content">

        <header class="content-header">
            <h1 class="page-title">База пользователей</h1>
            <a href="#" class="logout-trigger" id="logoutBtn">
                <span class="logout-text">Выйти</span>
                <span class="logout-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                </span>
            </a>
        </header>

        <form class="filters-container" method="get" action="/Admin/Users" id="filterForm">
            <div class="search-wrapper">
                <input type="text" name="search" class="search-input" placeholder="Поиск по логину или почте" value="@Model.Search">
                <button type="submit" class="search-icon-btn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
            </div>

            <div class="select-wrapper">
                <select name="role" class="filter-select" onchange="document.getElementById('filterForm').submit()">
                    <!option value="" @(string.IsNullOrEmpty(selectedRole) ? "selected" : "")>Роль: Все</!option>
                    @foreach (var role in Model.Roles)
                    {
                        <!option value="@role.Id" @(selectedRole == role.Id.ToString() ? "selected" : "")>@role.RoleName</!option>
                    }
                </select>
            </div>

            <div class="select-wrapper">
                <select name="sort" class="filter-select" onchange="document.getElementById('filterForm').submit()">
                    <!option value="new" @(sort == "new" || string.IsNullOrEmpty(sort) ? "selected" : "")>Сначала новые</!option>
                    <!option value="old" @(sort == "old" ? "selected" : "")>Сначала старые</!option>
                </select>
            </div>
        </form>

        <section class="table-container">
            <table class="log-table">
                <thead>
                    <tr>
                        <th>Пользователь</th>
                        <th>Роль (Управление)</th>
                        <th class="text-right">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        var roleClass = user.IdRole switch
                        {
                            1 => "size-admin text-admin",
                            2 => "size-moderator text-moderator",
                            3 => "size-jury text-jury",
                            _ => "size-participant text-participant"
                        };

                        <tr id="user-row-@user.Id">
                            <td>
                                <div class="user-info-cell">
                                    <span class="user-name-title">@user.Login</span>
                                    <span class="user-email-subtitle">@user.Email</span>
                                </div>
                            </td>
                            <td>
                                @{
                                    var isCurrentAdmin = user.Login == adminLogin;
                                }
                                @if (isCurrentAdmin)
                                {
                                    <div class="table-select-wrapper size-admin text-admin">
                                        <select class="role-table-select" disabled>
                                            <option selected>Администратор</option>
                                        </select>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-select-wrapper @roleClass" id="role-wrapper-@user.Id">
                                        <select class="role-table-select" onchange="changeRole(@user.Id, this.value)">
                                            @foreach (var role in Model.Roles)
                                            {
                                                <!option value="@role.Id" @(user.IdRole == role.Id ? "selected" : "")>@role.RoleName</!option>
                                            }
                                        </select>
                                    </div>
                                }
                            </td>
                            <td class="text-right">
                                @if (!isCurrentAdmin)
                                {
                                    <button type="button" class="btn-table-delete" onclick="confirmDelete(@user.Id, '@user.Login')">Удалить</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </main>

    <div id="modalOverlay" class="modal-overlay" style="display:none;">
        <div class="modal-box">
            <h3 class="modal-title" id="modalTitle">Подтверждение</h3>
            <p class="modal-text" id="modalText">Вы уверены?</p>
            <div class="modal-actions">
                <button class="modal-btn modal-btn-cancel" onclick="closeModal()">Отмена</button>
                <button class="modal-btn modal-btn-confirm" id="modalConfirmBtn">Подтвердить</button>
            </div>
        </div>
    </div>

    <script src="~/js/admin-users.js"></script>

</body>
</html>
