@model List<ArtContest.Models.Submission>
@{
    var contest = ViewBag.Contest as ArtContest.Models.Contest;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtContest - Заявки конкурса</title>
    <link rel="stylesheet" href="~/css/ModContestItems.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <header class="top-bar">
        <a href="/Moderator/Home" class="back-link">
            <span class="back-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </span>
            Конкурс: @(contest?.Title ?? "—")
        </a>
    </header>

    <main class="page-content">
        <section class="info-section">
            <h2 class="info-section-title">Правила и описание</h2>
            <div class="info-text-block">
                <p>@(contest?.Rules ?? "Нет описания")</p>
            </div>
        </section>

        <section class="table-section">
            <h2 class="info-section-title">Список заявок на модерации</h2>

            <div class="table-container">
                <table class="items-table">
                    <thead>
                        <tr>
                            <th>Название работы</th>
                            <th>Автор</th>
                            <th>Дата подачи</th>
                            <th>Действие</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var submission in Model)
                            {
                                <tr>
                                    <td><span class="work-name-td">@submission.Title</span></td>
                                    <td>@submission.User?.Login</td>
                                    <td>@submission.SubmissionDate</td>
                                    <td><a href="/Moderator/Review?submissionId=@submission.Id" class="btn-table-action">Проверить</a></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align:center;padding:40px;color:#7c8295;">Нет заявок на модерации</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>

</body>
</html>
