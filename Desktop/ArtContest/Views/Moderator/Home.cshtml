@model List<ArtContest.Models.Contest>
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ArtContest - Модерация</title>
    <link rel="stylesheet" href="~/css/ModHome.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <aside class="sidebar">
        <div class="logo">ArtContest</div>
        <nav class="menu">
            <a href="/Moderator/Home" class="menu-item active">Главная</a>
            <a href="/Moderator/Log" class="menu-item">Журнал</a>
        </nav>
    </aside>

    <main class="main-content">
        <header class="content-header">
            <h1 class="page-title">Конкурсы на проверку</h1>
            <div class="user-badge-inline">
                <span class="user-role-tag">Модератор:</span>
                <span class="user-login-label">@ViewBag.ModeratorLogin</span>
            </div>
        </header>

        <form class="filters-container" method="get" action="/Moderator/Home">
            <div class="search-wrapper">
                <input type="text" name="search" class="search-input" placeholder="Поиск конкурсов" value="@ViewBag.Search">
                <button type="submit" class="search-icon-btn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
            </div>

            <div class="select-wrapper">
                <select name="category" class="filter-select" onchange="this.form.submit()">
                    @{
                        var modCatSel = string.IsNullOrEmpty(ViewBag.SelectedCategory) ? "selected" : null;
                    }
                    <option value="" selected="@modCatSel">Категория</option>
                    @foreach (var cat in ViewBag.Categories as List<ArtContest.Models.ContestCategory>)
                    {
                        var modCatItemSel = ViewBag.SelectedCategory == cat.Id.ToString() ? "selected" : null;
                        <option value="@cat.Id" selected="@modCatItemSel">@cat.CategoryName</option>
                    }
                </select>
            </div>

            <div class="select-wrapper">
                <select name="sort" class="filter-select" onchange="this.form.submit()">
                    @{
                        var modSortNew = ViewBag.Sort == "new" || string.IsNullOrEmpty(ViewBag.Sort) ? "selected" : null;
                        var modSortOld = ViewBag.Sort == "old" ? "selected" : null;
                    }
                    <option value="new" selected="@modSortNew">Сначала новые</option>
                    <option value="old" selected="@modSortOld">Сначала старые</option>
                </select>
            </div>

        </form>

        <section class="contests-grid">
            @if (Model.Any())
            {
                @foreach (var contest in Model)
                {
                    <article class="contest-card">
                        @if (!string.IsNullOrEmpty(contest.ContestImage))
                        {
                            <div class="contest-image-holder" style="background-image:url('@Url.Content("~/images/" + contest.ContestImage)');background-size:cover;background-position:center;"></div>
                        }
                        else
                        {
                            <div class="contest-image-holder image-bg-blue"></div>
                        }
                        <div class="contest-card-content">
                            <h2 class="contest-title">@contest.Title</h2>
                            <p class="contest-info">Категория: @contest.Category?.CategoryName</p>
                            <p class="contest-counter-alert">Новых заявок: @contest.NewSubmissionsCount</p>
                            <a href="/Moderator/ContestItems/@contest.Id" class="btn-action">Смотреть заявки</a>
                        </div>
                    </article>
                }
            }
            else
            {
                <div style="width:100%;text-align:center;padding:60px 20px;color:#7c8295;font-size:16px;">
                    Нет конкурсов для модерации
                </div>
            }
        </section>
    </main>

</body>
</html>
